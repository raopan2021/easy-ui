{
  "name": "easy-ui",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter ease-ui-docs dev",
    "dev:docs": "pnpm --filter ease-ui-docs dev",
    "build": "pnpm --filter ease-ui-docs build",
    "build:docs": "pnpm --filter ease-ui-docs build",
    "preview": "pnpm --filter ease-ui-docs preview",
    "dev:admin": "pnpm --dir template-admin dev",
    "build:admin": "pnpm --dir template-admin build",
    "build:admin:staging": "pnpm --dir template-admin build:staging",
    "build:lib": "pnpm --filter @raopan/easy-ui build && pnpm --dir template-admin install",
    "build:lib:watch": "pnpm --filter @raopan/easy-ui dev",
    "publish:lib": "node scripts/publish.mjs",
    "type-check": "pnpm --filter ease-ui-docs type-check && pnpm --filter @raopan/easy-ui type-check",
    "type-check:doc": "pnpm --filter ease-ui-docs type-check",
    "type-check:lib": "pnpm --filter @raopan/easy-ui type-check",
    "lint": "eslint . --fix --cache",
    "lint:check": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm type-check && pnpm lint:check && pnpm test:run"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@element-plus/icons-vue": "catalog:",
    "@logicflow/core": "catalog:",
    "@logicflow/extension": "catalog:",
    "@tsconfig/node24": "catalog:",
    "@types/gradient-string": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "@vue-office/docx": "catalog:",
    "@vue-office/excel": "catalog:",
    "@vue-office/pdf": "catalog:",
    "@vue/test-utils": "catalog:",
    "@vue/tsconfig": "catalog:",
    "@vueuse/core": "catalog:",
    "@wangeditor/editor": "catalog:",
    "@wangeditor/editor-for-vue": "catalog:",
    "axios": "catalog:",
    "boxen": "catalog:",
    "cropperjs": "catalog:",
    "crypto-js": "catalog:",
    "docx": "catalog:",
    "echarts": "catalog:",
    "element-plus": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "eslint-plugin-unicorn": "catalog:",
    "gradient-string": "catalog:",
    "highlight.js": "catalog:",
    "html2canvas": "catalog:",
    "html2pdf.js": "catalog:",
    "jiti": "catalog:",
    "jsbarcode": "catalog:",
    "jsdom": "catalog:",
    "jszip": "catalog:",
