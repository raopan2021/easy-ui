{
  "name": "easy-ui",
  "version": "1.0.0",
  "description": "Vue 3 企业级组件库，基于 Element Plus 扩展",
  "private": true,
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    },
    "./*": "./dist/*"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:lib": "vite build --config vite.config.lib.ts && vue-tsc -p tsconfig.lib.json",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@vueuse/core": "^14.3.0",
    "axios": "^1.4.0",
    "pinia": "^3.0.4"
  },
  "peerDependencies": {
    "vue": "^3.5.29",
    "vue-router": "^5.0.3",
    "element-plus": "^2.13.6",
    "@element-plus/icons-vue": "^2.3.2"
  },
  "peerDependenciesMeta": {
    "echarts": { "optional": true },
    "@logicflow/core": { "optional": true },
    "@logicflow/extension": { "optional": true },
    "@vue-office/docx": { "optional": true },
    "@vue-office/excel": { "optional": true },
    "@vue-office/pdf": { "optional": true },
    "cropperjs": { "optional": true },
    "crypto-js": { "optional": true },
    "jsbarcode": { "optional": true },
    "jszip": { "optional": true },
    "markdown-it": { "optional": true },
    "pdf-lib": { "optional": true },
    "pdfjs-dist": { "optional": true },
    "pptx-preview": { "optional": true },
    "qrcode": { "optional": true },
    "highlight.js": { "optional": true }
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/cropperjs": "^1.3.3",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^24.11.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/eslint-plugin": "^1.6.9",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.50.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "jsdom": "^28.1.0",
    "highlight.js": "^11.11.1",
    "lightningcss": "^1.32.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.50.0",
    "prettier": "3.8.1",
    "sass-embedded": "^1.98.0",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-element-plus": "^0.10.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.3",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-vue-devtools": "^8.1.0",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
