{
  "name": "@raopan/easy-ui",
  "version": "1.0.0",
  "type": "module",
  "description": "Vue 3 企业级组件库，基于 Element Plus 扩展",
  "license": "MIT",
  "author": "莫名 (1447455287@qq.com)",
  "keywords": [
    "vue",
    "vue3",
    "component-library",
    "element-plus",
    "easy-ui",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raopan2021/easy-ui.git"
  },
  "homepage": "https://github.com/raopan2021/easy-ui#readme",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "**/*.vue",
    "dist/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/easy-ui/src/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./file-preview": {
      "types": "./dist/easy-ui/file-preview.d.ts",
      "import": "./dist/file-preview.mjs"
    },
    "./flow-designer": {
      "types": "./dist/easy-ui/flow-designer.d.ts",
      "import": "./dist/flow-designer.mjs"
    },
    "./markdown": {
      "types": "./dist/easy-ui/markdown.d.ts",
      "import": "./dist/markdown.mjs"
    },
    "./richtext": {
      "types": "./dist/easy-ui/richtext.d.ts",
      "import": "./dist/richtext.mjs"
    },
    "./dist/easy-ui.css": "./dist/easy-ui.css",
    "./dist/index.mjs": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/easy-ui/src/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && pnpm build:types",
    "build:types": "vue-tsc -p tsconfig.lib.json",
    "dev": "vite build --watch",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.13.6",
    "vue": "^3.5.29",
    "vue-router": "^5.0.3",
    "@logicflow/core": "^2.1.11",
    "@logicflow/extension": "^2.1.15",
    "@vue-office/docx": "^1.6.3",
    "@vue-office/excel": "^1.7.14",
    "@vue-office/pdf": "^2.0.10",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "cropperjs": "1.6.2",
    "crypto-js": "^4.2.0",
    "echarts": "^6.0.0",
    "highlight.js": "^11.11.1",
    "jsbarcode": "^3.12.3",
    "jszip": "^3.10.1",
    "markdown-it": "^14.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "2.16.105",
    "pptx-preview": "^1.0.7",
    "qrcode": "^1.5.4"
  },
  "peerDependenciesMeta": {
    "@logicflow/core": {
      "optional": true
    },
    "@logicflow/extension": {
      "optional": true
    },
    "@vue-office/docx": {
      "optional": true
    },
    "@vue-office/excel": {
      "optional": true
    },
    "@vue-office/pdf": {
      "optional": true
    },
    "@wangeditor/editor": {
      "optional": true
    },
    "@wangeditor/editor-for-vue": {
      "optional": true
    },
    "cropperjs": {
      "optional": true
    },
    "crypto-js": {
      "optional": true
    },
    "echarts": {
      "optional": true
    },
    "highlight.js": {
      "optional": true
    },
    "jsbarcode": {
      "optional": true
    },
    "jszip": {
      "optional": true
    },
    "markdown-it": {
      "optional": true
    },
    "pdf-lib": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    },
    "pptx-preview": {
      "optional": true
    },
    "qrcode": {
      "optional": true
    }
  },
  "dependencies": {
    "@vueuse/core": "^14.3.0",
    "axios": "^1.4.0",
    "pinia": "^3.0.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.8.1",
    "sass-embedded": "^1.98.0",
    "typescript": "~5.9.3",
    "vite": "^8.1.3",
    "vue-tsc": "^3.2.5"
  }
}
