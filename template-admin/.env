# 平台本地运行端口号
VITE_PORT = 3100

# 是否隐藏首页 隐藏 true 不隐藏 false （勿删除，VITE_HIDE_HOME只需在.env文件配置）
VITE_HIDE_HOME = false

# 开发环境读取配置文件路径
VITE_PUBLIC_PATH = /admin/

# 开发环境路由历史模式（Hash模式传"hash"、HTML5模式传"h5"、Hash模式带base参数传"hash,base参数"、HTML5模式带base参数传"h5,base参数"）
# 使用 hash 模式：部署到 GitHub Pages（无 SPA fallback）时深层路由刷新不 404
VITE_ROUTER_HISTORY = "hash,/admin/"

VITE_OUTDIR = "dist/admin/"
