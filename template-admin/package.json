{
  "name": "template-admin",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "author": {
    "name": "xiaoxian521",
    "email": "pureadmin@163.com",
    "url": "https://github.com/xiaoxian521"
  },
  "license": "MIT",
  "homepage": "https://github.com/pure-admin/pure-admin-thin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pure-admin/pure-admin-thin.git"
  },
  "bugs": {
    "url": "https://github.com/pure-admin/vue-pure-admin/issues"
  },
  "keywords": [
    "pure-admin-thin",
    "vue-pure-admin",
    "element-plus",
    "tailwindcss",
    "pure-admin",
    "typescript",
    "pinia",
    "vue3",
    "vite",
    "esm"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vp dev",
    "serve": "pnpm dev",
    "build": "vp build",
    "build:test": "vp build --mode test",
    "preview": "vp preview",
    "preview:build": "pnpm build && vp preview",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit --skipLibCheck",
    "clean:cache": "node -e \"require('fs').rmSync('.eslintcache',{recursive:true,force:true})\" && node -e \"require('fs').rmSync('pnpm-lock.yaml',{force:true})\" && node -e \"require('fs').rmSync('node_modules',{recursive:true,force:true})\" && pnpm store prune && pnpm install",
    "lint:eslint": "vp lint --max-warnings 0 \"{src,mock,build}/**/*.{vue,js,ts,tsx}\" --fix",
    "lint:prettier": "prettier --write  \"src/**/*.{js,ts,json,tsx,css,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint --cache --fix \"**/*.{html,vue,css,scss}\" --cache-location node_modules/.cache/stylelint/",
    "lint": "pnpm lint:eslint && pnpm lint:prettier && pnpm lint:stylelint",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@pureadmin/utils": "2.6.4",
    "@raopan/easy-ui": "^1.1.2",
    "@vueuse/core": "^14.3.0",
    "@vueuse/motion": "3.0.3",
    "animate.css": "4.1.1",
    "axios": "^1.4.0",
    "dayjs": "1.11.23",
    "element-plus": "^2.13.6",
    "highlight.js": "^11.11.1",
    "js-cookie": "3.0.8",
    "localforage": "1.10.0",
    "markdown-it": "^14.1.1",
    "mitt": "3.0.1",
    "nprogress": "0.2.0",
    "path-browserify": "1.0.1",
    "pinia": "^3.0.4",
    "pinyin-pro": "3.29.3",
    "qs": "6.15.3",
    "responsive-storage": "2.2.0",
    "sortablejs": "1.15.7",
    "tippy.js": "6.3.7",
    "vue": "^3.5.29",
    "vue-router": "^5.0.3",
    "vue-tippy": "6.7.1",
    "vue-types": "7.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@commitlint/types": "21.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/js-cookie": "3.0.6",
    "@types/node": "^24.11.0",
    "@types/nprogress": "0.2.3",
    "@types/path-browserify": "1.0.3",
    "@types/qs": "6.15.1",
    "@types/sortablejs": "1.15.9",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "boxen": "^8.0.1",
    "code-inspector-plugin": "2.0.8",
    "cross-env": "10.1.0",
    "esbuild": "^0.28.2",
    "eslint-plugin-prettier": "5.5.6",
    "gradient-string": "^3.0.0",
    "lightningcss": "^1.32.0",
    "postcss": "8.5.26",
    "postcss-html": "2.0.0",
    "postcss-scss": "4.0.9",
    "prettier": "3.9.6",
    "sass-embedded": "^1.98.0",
    "stylelint": "17.14.1",
    "stylelint-config-recess-order": "7.8.0",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-prettier": "5.0.3",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-router-warn": "2.0.0",
    "vite-plus": "0.2.9",
    "vite-svg-loader": "5.1.2",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "^3.2.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  }
}
