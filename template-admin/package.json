{
  "name": "template-admin",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "author": {
    "name": "xiaoxian521",
    "email": "pureadmin@163.com",
    "url": "https://github.com/xiaoxian521"
  },
  "license": "MIT",
  "homepage": "https://github.com/pure-admin/pure-admin-thin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pure-admin/pure-admin-thin.git"
  },
  "bugs": {
    "url": "https://github.com/pure-admin/vue-pure-admin/issues"
  },
  "keywords": [
    "pure-admin-thin",
    "vue-pure-admin",
    "element-plus",
    "tailwindcss",
    "pure-admin",
    "typescript",
    "pinia",
    "vue3",
    "vite",
    "esm"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vp dev",
    "serve": "pnpm dev",
    "build": "vp build",
    "build:test": "vp build --mode test",
    "build:staging": "vp build --mode staging",
    "preview": "vp preview",
    "preview:build": "pnpm build && vp preview",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit --skipLibCheck",
    "clean:cache": "node -e \"require('fs').rmSync('.eslintcache',{recursive:true,force:true})\" && node -e \"require('fs').rmSync('pnpm-lock.yaml',{force:true})\" && node -e \"require('fs').rmSync('node_modules',{recursive:true,force:true})\" && pnpm store prune && pnpm install",
    "lint:eslint": "vp lint --max-warnings 0 \"{src,mock,build}/**/*.{vue,js,ts,tsx}\" --fix",
    "lint:prettier": "prettier --write  \"src/**/*.{js,ts,json,tsx,css,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint --cache --fix \"**/*.{html,vue,css,scss}\" --cache-location node_modules/.cache/stylelint/",
    "lint": "pnpm lint:eslint && pnpm lint:prettier && pnpm lint:stylelint",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@pureadmin/utils": "^2.6.4",
    "@raopan/easy-ui": "file:../packages/easy-ui",
    "@vueuse/core": "^14.3.0",
    "@vueuse/motion": "^3.0.3",
    "animate.css": "^4.1.1",
    "axios": "^1.18.1",
    "cropperjs": "^1.6.2",
    "dayjs": "^1.11.21",
    "element-plus": "^2.14.2",
    "highlight.js": "^11.12.0",
    "js-cookie": "^3.0.8",
    "jsbarcode": "^3.12.3",
    "localforage": "^1.10.0",
    "markdown-it": "^15.0.0",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "path-browserify": "^1.0.1",
    "pinia": "^4.0.3",
    "pinyin-pro": "^3.28.1",
    "qrcode": "^1.5.4",
    "qs": "^6.15.3",
    "responsive-storage": "^2.2.0",
    "sortablejs": "^1.15.7",
    "tippy.js": "^6.3.7",
    "vue": "^3.5.39",
    "vue-router": "^5.2.0",
    "vue-tippy": "^6.7.1",
    "vue-types": "^7.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@commitlint/types": "^20.0.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20.19.23",
    "@types/nprogress": "^0.2.3",
    "@types/path-browserify": "^1.0.3",
    "@types/qs": "^6.14.0",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "boxen": "^8.0.1",
    "code-inspector-plugin": "^1.2.10",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint-plugin-prettier": "^5.5.4",
    "gradient-string": "^3.0.0",
    "lightningcss": "^1.32.0",
    "postcss": "^8.5.6",
    "postcss-html": "^1.8.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.6.2",
    "sass-embedded": "^1.100.0",
    "stylelint": "^16.25.0",
    "stylelint-config-recess-order": "^7.4.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-prettier": "^5.0.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "catalog:",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-router-warn": "^2.0.0",
    "vite-plus": "catalog:",
    "vite-svg-loader": "^5.1.0",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  }
}
