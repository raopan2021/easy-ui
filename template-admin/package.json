{
  "name": "template-admin",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "author": {
    "name": "xiaoxian521",
    "email": "pureadmin@163.com",
    "url": "https://github.com/xiaoxian521"
  },
  "license": "MIT",
  "homepage": "https://github.com/pure-admin/pure-admin-thin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pure-admin/pure-admin-thin.git"
  },
  "bugs": {
    "url": "https://github.com/pure-admin/vue-pure-admin/issues"
  },
  "keywords": [
    "pure-admin-thin",
    "vue-pure-admin",
    "element-plus",
    "tailwindcss",
    "pure-admin",
    "typescript",
    "pinia",
    "vue3",
    "vite",
    "esm"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vp dev",
    "serve": "pnpm dev",
    "build": "vp build",
    "build:test": "vp build --mode test",
    "preview": "vp preview",
    "preview:build": "pnpm build && vp preview",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit --skipLibCheck",
    "clean:cache": "node -e \"require('fs').rmSync('.eslintcache',{recursive:true,force:true})\" && node -e \"require('fs').rmSync('pnpm-lock.yaml',{force:true})\" && node -e \"require('fs').rmSync('node_modules',{recursive:true,force:true})\" && pnpm store prune && pnpm install",
    "lint:eslint": "vp lint --max-warnings 0 \"{src,mock,build}/**/*.{vue,js,ts,tsx}\" --fix",
    "lint:prettier": "prettier --write  \"src/**/*.{js,ts,json,tsx,css,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint --cache --fix \"**/*.{html,vue,css,scss}\" --cache-location node_modules/.cache/stylelint/",
    "lint": "pnpm lint:eslint && pnpm lint:prettier && pnpm lint:stylelint",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@element-plus/icons-vue": "catalog:",
    "@pureadmin/utils": "catalog:",
    "@raopan/easy-ui": "file:../packages/easy-ui",
    "@vueuse/core": "catalog:",
    "@vueuse/motion": "catalog:",
    "animate.css": "catalog:",
    "axios": "catalog:",
    "cropperjs": "catalog:",
    "dayjs": "catalog:",
    "docx": "catalog:",
    "element-plus": "catalog:",
    "highlight.js": "catalog:",
    "html2canvas": "catalog:",
    "html2pdf.js": "catalog:",
    "js-cookie": "catalog:",
    "jsbarcode": "catalog:",
    "localforage": "catalog:",
    "markdown-it": "catalog:",
    "mermaid": "catalog:",
    "mitt": "catalog:",
    "nprogress": "catalog:",
    "path-browserify": "catalog:",
    "pinia": "catalog:",
    "pinyin-pro": "catalog:",
    "qrcode": "catalog:",
    "qs": "catalog:",
    "responsive-storage": "catalog:",
    "sortablejs": "catalog:",
    "tippy.js": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "vue-tippy": "catalog:",
    "vue-types": "catalog:"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/js-cookie": "catalog:",
    "@types/node": "catalog:",
    "@types/nprogress": "catalog:",
    "@types/path-browserify": "catalog:",
    "@types/qs": "catalog:",
    "@types/sortablejs": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "boxen": "catalog:",
    "code-inspector-plugin": "catalog:",
    "cross-env": "catalog:",
    "esbuild": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "gradient-string": "catalog:",
    "lightningcss": "catalog:",
    "postcss": "catalog:",
    "postcss-html": "catalog:",
    "postcss-scss": "catalog:",
    "prettier": "catalog:",
    "sass-embedded": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-recess-order": "catalog:",
    "stylelint-config-recommended-vue": "catalog:",
    "stylelint-config-standard-scss": "catalog:",
    "stylelint-prettier": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "unplugin-auto-import": "catalog:",
    "unplugin-vue-components": "catalog:",
    "vite": "catalog:",
    "vite-plugin-compression": "catalog:",
    "vite-plugin-router-warn": "catalog:",
    "vite-plus": "catalog:",
    "vite-svg-loader": "catalog:",
    "vue-eslint-parser": "catalog:",
    "vue-tsc": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  }
}
