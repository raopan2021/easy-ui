{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "./dist",
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/index.ts", "src/components/**/*", "src/utils/**/*"],
  "exclude": ["src/**/__tests__/*", "src/views/**/*", "src/router/**/*", "src/stores/**/*", "src/layouts/**/*", "src/App.vue", "src/main.ts"]
}
