{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    // Path mapping for cleaner imports（与 vite.config.ts 的 @ alias 一致，指向 demo 目录）
    "paths": {
      "@/*": ["./src/*"]
    },
    // allowJs:true 让 vue-router 5.x 的 .js 类型导入（dist/index-*.js → .d.ts）能被正确解析；
    // 同时解决 flow-designer 内部 .js 工具的 TS7016
    "allowJs": true,
    "checkJs": false,
    // 关闭 noUncheckedIndexedAccess：它会让 arr[i] 变成 T|undefined，
    // 对库源码（packages/components、packages/utils）造成大量误报（如 chart 的 slice/map 等）
    "noUncheckedIndexedAccess": false
  },
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"]
}
